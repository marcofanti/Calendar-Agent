# Local overrides — copy to .env.local (gitignored) and fill in as needed.
# Values here take precedence over .env.

# Uncomment to enable interactive correction loop in TTY sessions:
# PROMPT_FOR_FAILURE=true

# Override profile config or learning directory per machine:
# AGENT_PROFILES_FILE=profiles.yaml
# AGENT_LEARNING_DIR=.calendar-agent/learned
# MAX_PROMPT_CHARS=12000
