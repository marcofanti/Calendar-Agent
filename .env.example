# Source mailbox. auto tries Yahoo IMAP first, then Gmail API/OAuth if Yahoo has
# no credentials or Yahoo IMAP fails.
MAIL_PROVIDER=auto
IMAP_FOLDER=INBOX

YAHOO_IMAP_USER=mfanti@yahoo.com
YAHOO_IMAP_PASSWORD=YOUR_YAHOO_APP_PASSWORD
YAHOO_IMAP_FOLDER=INBOX

# Gmail uses Sign in with Google via credentials.json and token.json.

# Google Calendar OAuth files live in the project root by default.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Optional direct Outlook sync. If absent or auth fails, ICS files are generated.
O365_CLIENT_ID=
O365_CLIENT_SECRET=

# LLM parser. Deterministic parsing still runs, but the LLM is always called to
# confirm or correct it. Default is local Ollama.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# For Gemini instead:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your-api-key
LLM_API_KEY=

ICS_OUTPUT_DIR=~/Downloads/inclubgolf
DRY_RUN=true

# Interactive learning. When true and running in a TTY, parse failures pause
# and ask for human correction before skipping.
PROMPT_FOR_FAILURE=false
AGENT_PROFILES_FILE=profiles.yaml
AGENT_LEARNING_DIR=.calendar-agent/learned
MAX_PROMPT_CHARS=12000
