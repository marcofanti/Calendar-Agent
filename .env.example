# ── Mail ─────────────────────────────────────────────────────────────────────
# yahoo  → IMAP only (no fallback)
# gmail  → Gmail API only
# auto   → try Yahoo IMAP first, fall back to Gmail API
MAIL_PROVIDER=yahoo

# Yahoo IMAP credentials (required when MAIL_PROVIDER=yahoo or auto)
YAHOO_IMAP_USER=your-address@yahoo.com
YAHOO_IMAP_PASSWORD=your-yahoo-app-password   # generated app password, no spaces/hyphens
YAHOO_IMAP_FOLDER=INBOX
YAHOO_IMAP_TRASH_FOLDER=Trash

# ── Google ───────────────────────────────────────────────────────────────────
# Primary Google account — used for Calendar writes and optionally Gmail reads.
# Create credentials.json as a Desktop OAuth client in Google Cloud Console:
#   https://console.cloud.google.com/ → APIs → Credentials → Create → Desktop app
# Enable: Google Calendar API + Gmail API (if using Gmail as mail provider).
# First run opens a browser for consent and writes token.json automatically.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ── Additional mail accounts ─────────────────────────────────────────────────
# Per-profile mail accounts are configured in profiles.yaml (accounts: section),
# not here. Each account specifies its own credentials_file and token_file paths.
#
# Example in profiles.yaml:
#   accounts:
#     - name: caco
#       provider: gmail
#       credentials_file: caco_credentials.json   # OAuth JSON for caco.fanti@gmail.com
#       token_file: caco_token.json               # created on first run, gitignored
#
# No additional env vars are needed for secondary accounts.

# ── Outlook (optional) ───────────────────────────────────────────────────────
# Leave blank to skip direct Outlook sync; ICS files are written instead.
O365_CLIENT_ID=
O365_CLIENT_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Ollama (default — runs locally, no API key needed):
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# To use Gemini instead, comment the three lines above and uncomment these:
#LLM_PROVIDER=gemini
#LLM_MODEL=gemini-2.5-flash
#LLM_API_KEY=your-gemini-api-key

# ── Output ───────────────────────────────────────────────────────────────────
ICS_OUTPUT_DIR=~/Downloads/calendar-agent

# ── Agent behaviour ──────────────────────────────────────────────────────────
DRY_RUN=false          # true = parse and report only; no calendar writes, no trash
DEBUG=false            # true = verbose provider, IMAP, and per-email diagnostics
AGENT_PROFILES_FILE=profiles.yaml

# Interactive correction loop: pause on parse failures when running in a TTY.
PROMPT_FOR_FAILURE=false

# Learning storage and prompt size limit.
AGENT_LEARNING_DIR=.calendar-agent/learned
MAX_PROMPT_CHARS=12000
